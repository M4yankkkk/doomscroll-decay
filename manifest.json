{
  "manifest_version": 3,
  "name": "Doomscroll Decay",
  "version": "1.0.0",
  "description": "The longer you scroll your feeds, the more the page rots. Everything stays on your device.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Doomscroll Decay",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/instrument-serif-italic.woff2",
        "assets/fonts/inter-var.woff2",
        "assets/textures/erode.svg",
        "assets/textures/grain.svg"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
